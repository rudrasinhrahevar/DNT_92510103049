@model Product
@{
    ViewData["Title"] = "Delete product";
}

<a class="back-link" asp-action="Index">← Back to inventory</a>
<section class="delete-card">
    <div class="delete-icon">!</div>
    <div class="eyebrow">REMOVE INVENTORY ITEM</div>
    <h1>Delete this product?</h1>
    <p>This will permanently remove the item and its stock record. This action cannot be undone.</p>
    <div class="delete-preview">
        <div><span class="product-initial">@Model.Name[..1].ToUpperInvariant()</span><span><strong>@Model.Name</strong><small>@Model.Sku · @Model.Category</small></span></div>
        <strong>@Model.Quantity <small>units</small></strong>
    </div>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <button class="button button-danger" type="submit">Delete product</button>
        <a class="button button-light" asp-action="Details" asp-route-id="@Model.Id">Keep product</a>
    </form>
</section>
