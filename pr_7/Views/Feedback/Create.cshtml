@model pr_7.Models.Feedback

@{
    ViewData["Title"] = "Submit Feedback";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Feedback Form (HTML Helpers & Validation)</h4>
            </div>
            <div class="card-body p-4">
                <!-- Using strongly-typed HTML Helper BeginForm -->
                @using (Html.BeginForm("Create", "Feedback", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <!-- Validation Summary -->
                    @Html.ValidationSummary(true, "Please fix the following errors:", new { @class = "alert alert-danger" })

                    <!-- 1. Student Name (Html.TextBoxFor) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Name, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter student full name" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                    </div>

                    <!-- 2. Email Address (Html.TextBoxFor) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "e.g. student@gmail.com" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <!-- 3. Contact Number (Html.TextBoxFor) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ContactNo, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.ContactNo, new { @class = "form-control", placeholder = "Enter 10-digit mobile number" })
                        @Html.ValidationMessageFor(m => m.ContactNo, "", new { @class = "text-danger" })
                    </div>

                    <!-- 4. Category DropDownList (Html.DropDownListFor) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Category, new { @class = "form-label fw-bold" })
                        @Html.DropDownListFor(m => m.Category, ViewBag.Categories as SelectList, "-- Select Category --", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
                    </div>

                    <!-- 5. Rating (Html.TextBoxFor / Range 1 to 5) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Rating, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Rating, new { @class = "form-control", type = "number", min = "1", max = "5" })
                        @Html.ValidationMessageFor(m => m.Rating, "", new { @class = "text-danger" })
                        <small class="text-muted">Enter a rating between 1 (lowest) and 5 (highest).</small>
                    </div>

                    <!-- 6. Preferred Contact Method (Html.RadioButtonFor) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.ContactMethod, new { @class = "form-label fw-bold d-block" })
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.ContactMethod, "Email", new { id = "rdoEmail", @class = "form-check-input" })
                            <label for="rdoEmail" class="form-check-label">Email</label>
                        </div>
                        <div class="form-check form-check-inline">
                            @Html.RadioButtonFor(m => m.ContactMethod, "Phone", new { id = "rdoPhone", @class = "form-check-input" })
                            <label for="rdoPhone" class="form-check-label">Phone</label>
                        </div>
                        @Html.ValidationMessageFor(m => m.ContactMethod, "", new { @class = "text-danger" })
                    </div>

                    <!-- 7. Would Recommend CheckBox (Html.CheckBoxFor) -->
                    <div class="form-check mb-3">
                        @Html.CheckBoxFor(m => m.WouldRecommend, new { @class = "form-check-input", id = "chkRecommend" })
                        <label for="chkRecommend" class="form-check-label fw-bold">
                            Would you recommend this course / institution to others?
                        </label>
                    </div>

                    <!-- 8. Feedback Comments (Html.TextAreaFor) -->
                    <div class="mb-3">
                        @Html.LabelFor(m => m.Comments, new { @class = "form-label fw-bold" })
                        @Html.TextAreaFor(m => m.Comments, 4, 40, new { @class = "form-control", placeholder = "Enter your feedback comments here..." })
                        @Html.ValidationMessageFor(m => m.Comments, "", new { @class = "text-danger" })
                    </div>

                    <!-- Submit & Cancel Buttons -->
                    <div class="mt-4 pt-2 border-top">
                        <input type="submit" value="Submit Feedback" class="btn btn-primary px-4 me-2" />
                        <input type="reset" value="Clear" class="btn btn-outline-secondary me-2" />
                        @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-link" })
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- jQuery Unobtrusive Client-side Validation scripts -->
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
