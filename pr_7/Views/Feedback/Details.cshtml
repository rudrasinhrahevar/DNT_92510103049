@model pr_7.Models.Feedback

@{
    ViewData["Title"] = "Feedback Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">Feedback Details (ID: @Model.Id)</h4>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 pb-2">Student Name:</dt>
                    <dd class="col-sm-8 pb-2 fw-bold">@Model.Name</dd>

                    <dt class="col-sm-4 pb-2">Email Address:</dt>
                    <dd class="col-sm-8 pb-2">@Model.Email</dd>

                    <dt class="col-sm-4 pb-2">Contact Number:</dt>
                    <dd class="col-sm-8 pb-2">@Model.ContactNo</dd>

                    <dt class="col-sm-4 pb-2">Feedback Category:</dt>
                    <dd class="col-sm-8 pb-2"><span class="badge bg-secondary">@Model.Category</span></dd>

                    <dt class="col-sm-4 pb-2">Rating Given:</dt>
                    <dd class="col-sm-8 pb-2"><strong class="text-warning">@Model.Rating / 5 ★</strong></dd>

                    <dt class="col-sm-4 pb-2">Preferred Contact:</dt>
                    <dd class="col-sm-8 pb-2">@Model.ContactMethod</dd>

                    <dt class="col-sm-4 pb-2">Would Recommend:</dt>
                    <dd class="col-sm-8 pb-2">
                        @if (Model.WouldRecommend)
                        {
                            <span class="text-success fw-bold">Yes</span>
                        }
                        else
                        {
                            <span class="text-danger fw-bold">No</span>
                        }
                    </dd>

                    <dt class="col-sm-4 pb-2">Submitted Date:</dt>
                    <dd class="col-sm-8 pb-2">@Model.SubmittedDate.ToString("dd MMMM yyyy, hh:mm tt")</dd>

                    <dt class="col-sm-4">Comments:</dt>
                    <dd class="col-sm-8 p-3 bg-light border rounded">@Model.Comments</dd>
                </dl>
            </div>
            <div class="card-footer bg-white">
                @Html.ActionLink("Back to Feedback List", "Index", null, new { @class = "btn btn-secondary" })
                @Html.ActionLink("Delete Feedback", "Delete", new { id = Model.Id }, new { 
                    @class = "btn btn-danger float-end",
                    onclick = "return confirm('Are you sure you want to delete this record?');"
                })
            </div>
        </div>
    </div>
</div>
