@model IEnumerable<pr_7.Models.Feedback>

@{
    ViewData["Title"] = "Feedback List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Feedback Management - Student Records</h2>
    <a asp-action="Create" class="btn btn-primary">
        + Submit New Feedback
    </a>
</div>

<!-- 1. Demonstration of Partial View -->
@await Html.PartialAsync("_FeedbackSummaryPartial", Model)

<!-- 2. Standard Bootstrap Table for Feedback Records -->
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <strong>All Submitted Feedbacks (@Model.Count())</strong>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-4 text-center text-muted">
                No feedback records found. Click "Submit New Feedback" to add one.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th style="width: 50px;">#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Category</th>
                            <th style="width: 90px;">Rating</th>
                            <th>Comments</th>
                            <th style="width: 110px;">Recommend</th>
                            <th style="width: 120px;">Date</th>
                            <th style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td><strong>@item.Name</strong></td>
                                <td>@item.Email</td>
                                <td><span class="badge bg-secondary">@item.Category</span></td>
                                <td>
                                    <span class="text-warning fw-bold">@item.Rating ★</span>
                                </td>
                                <td>@item.Comments</td>
                                <td>
                                    @if (item.WouldRecommend)
                                    {
                                        <span class="text-success fw-bold">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">No</span>
                                    }
                                </td>
                                <td>@item.SubmittedDate.ToString("dd-MM-yyyy")</td>
                                <td>
                                    @Html.ActionLink("Details", "Details", new { id = item.Id }, new { @class = "btn btn-info btn-sm text-white" })
                                    @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { 
                                        @class = "btn btn-danger btn-sm", 
                                        onclick = "return confirm('Are you sure you want to delete this record?');" 
                                    })
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
