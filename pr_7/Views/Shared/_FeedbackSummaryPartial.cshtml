@model IEnumerable<pr_7.Models.Feedback>

@{
    var list = Model?.ToList() ?? new List<pr_7.Models.Feedback>();
    var count = list.Count;
    var avgRating = count > 0 ? list.Average(f => f.Rating).ToString("0.0") : "0.0";
    var recommendCount = count > 0 ? list.Count(f => f.WouldRecommend) : 0;
}

<!-- Partial View: _FeedbackSummaryPartial.cshtml -->
<div class="card mb-4 border-info">
    <div class="card-header bg-info text-white fw-bold">
        Feedback Summary (Rendered via Partial View)
    </div>
    <div class="card-body">
        <div class="row text-center">
            <div class="col-md-4">
                <h6 class="text-muted">Total Feedbacks</h6>
                <h3 class="text-primary mb-0">@count</h3>
            </div>
            <div class="col-md-4">
                <h6 class="text-muted">Average Rating</h6>
                <h3 class="text-warning mb-0">@avgRating / 5 ★</h3>
            </div>
            <div class="col-md-4">
                <h6 class="text-muted">Recommendations</h6>
                <h3 class="text-success mb-0">@recommendCount of @count</h3>
            </div>
        </div>
    </div>
</div>
