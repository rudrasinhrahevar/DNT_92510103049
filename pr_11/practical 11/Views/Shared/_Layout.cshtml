<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · CampusConnect</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">C</span> CampusConnect</a>
        <nav>
            <a asp-controller="Home" asp-action="Index">Overview</a>
            <a asp-controller="Requests" asp-action="Index">Service requests</a>
            <a class="nav-cta" asp-controller="Requests" asp-action="Create">New request <span aria-hidden="true">+</span></a>
        </nav>
    </header>
    <main class="page">
        @if (TempData["Success"] is string success)
        {
            <div class="notice" role="status">@success</div>
        }
        @RenderBody()
    </main>
    <footer>CampusConnect <span>·</span> Campus services, made simpler</footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
