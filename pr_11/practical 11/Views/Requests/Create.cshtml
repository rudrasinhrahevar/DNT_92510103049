@model ServiceRequestForm
@{
    ViewData["Title"] = "New request";
}

<div class="form-layout">
    <div class="form-intro">
        <a class="back-link" asp-action="Index">← All requests</a>
        <div class="eyebrow dark-eyebrow">WE'RE HERE TO HELP</div>
        <h1>What needs<br />taking care of?</h1>
        <p>Tell us a little about what's happening. The right campus team will pick it up.</p>
        <div class="help-card"><span class="help-icon">✳</span><div><strong>Good to know</strong><p>Include a building and room number if you can. It helps us get there sooner.</p></div></div>
    </div>
    <form class="form-card" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Title"></label>
        <input asp-for="Title" placeholder="e.g. Projector not working in lecture hall" />
        <span asp-validation-for="Title" class="field-error"></span>

        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4" placeholder="Describe the issue and anything else we should know"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>

        <div class="form-grid">
            <div><label asp-for="Category"></label>
                <select asp-for="Category">
                    <option value="">Choose a team</option>
                    <option>Facilities</option><option>IT Support</option><option>Cleaning</option>
                    <option>Transport</option><option>Security</option><option>Other</option>
                </select>
                <span asp-validation-for="Category" class="field-error"></span>
            </div>
            <div><label asp-for="Priority"></label>
                <select asp-for="Priority"><option>Low</option><option>Medium</option><option>High</option><option>Urgent</option></select>
                <span asp-validation-for="Priority" class="field-error"></span>
            </div>
        </div>
        <label asp-for="Location"></label>
        <input asp-for="Location" placeholder="Building, floor, and room" />
        <span asp-validation-for="Location" class="field-error"></span>

        <div class="form-grid">
            <div><label asp-for="RequesterName"></label><input asp-for="RequesterName" placeholder="Your full name" /><span asp-validation-for="RequesterName" class="field-error"></span></div>
            <div><label asp-for="RequesterEmail"></label><input asp-for="RequesterEmail" placeholder="you@campus.edu" /><span asp-validation-for="RequesterEmail" class="field-error"></span></div>
        </div>
        <div class="form-actions"><a class="cancel-link" asp-action="Index">Cancel</a><button type="submit" class="button button-primary">Send request <span aria-hidden="true">→</span></button></div>
    </form>
</div>
